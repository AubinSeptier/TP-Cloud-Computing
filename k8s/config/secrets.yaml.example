# This is an example of a secrets.yaml file for the Kubernetes deployment of the application.
# Rename this file to secrets.yaml and fill in the required values.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
type: Opaque
data:
  POSTGRES_USER: YOUR_BASE64_ENCODED_POSTGRES_USER
  POSTGRES_PASSWORD: YOUR_BASE64_ENCODED_POSTGRES_PASSWORD
  JWT_SECRET_KEY: YOUR_SECRET_JWT_KEY